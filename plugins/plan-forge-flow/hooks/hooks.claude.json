{
  "description": "Capture non-blocking Plan Forge subagent evidence outside the repository.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/capture-claude-agent-evidence.mjs"
            ],
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^plan-forge-flow:forge-(reviewer|builder)-(none|low|medium|high|xhigh|max)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/capture-claude-agent-evidence.mjs"
            ],
            "async": true,
            "timeout": 5
          }
        ]
      }
    ]
  }
}
