{
  "description": "Enforce the Claude Plan Forge planning and execution gates and capture non-blocking subagent evidence outside the repository.",
  "hooks": {
    "UserPromptExpansion": [
      {
        "matcher": "^plan-forge-flow:forge$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/claude-workflow-hook.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "if": "Skill(plan-forge-flow:forge)",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/claude-workflow-hook.mjs"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/claude-workflow-hook.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/claude-workflow-hook.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/capture-claude-agent-evidence.mjs"
            ],
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^plan-forge-flow:forge-(reviewer|builder)-(none|low|medium|high|xhigh|max)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/capture-claude-agent-evidence.mjs"
            ],
            "async": true,
            "timeout": 5
          }
        ]
      }
    ]
  }
}
