{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/capture-context.mjs\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT\\scripts\\capture-context.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
