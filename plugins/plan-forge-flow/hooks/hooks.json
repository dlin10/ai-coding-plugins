{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$PLUGIN_ROOT/bin/planforge-launcher.sh\" hook capture-context",
            "commandWindows": "& \"$env:PLUGIN_ROOT\\bin\\planforge-launcher.ps1\" hook capture-context",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
