<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ConcurrencyHunter</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ConcurrencyHunter.Core.Tests" />
    <InternalsVisibleTo Include="ConcurrencyHunter.Cli.Tests" />
    <InternalsVisibleTo Include="ConcurrencyHunter.CoreLibGeneration" />
    <InternalsVisibleTo Include="ConcurrencyHunter.FrameworkGeneration" />
  </ItemGroup>

  <ItemGroup>
    <!-- The topical files sit at the top of BuiltIn, a framework's census files in a folder named after the framework. -->
    <EmbeddedResource Include="Providers\LibraryModels\BuiltIn\**\*.json" LogicalName="LibraryModels.BuiltIn.%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The model generator (SPEC TD-034b) decompiles a library's implementation assembly in memory. -->
    <PackageReference Include="ICSharpCode.Decompiler" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" GeneratePathProperty="true" />
    <!-- The solver lives here rather than in ConcurrencyHunter.Analysis, which carries no reference of
         any kind: Analysis owns the query and the degradation, this project binds them to Z3. See
         docs/adr/0004. -->
    <PackageReference Include="Microsoft.Z3" />
    <ProjectReference Include="..\ConcurrencyHunter.Analysis\ConcurrencyHunter.Analysis.csproj" />
  </ItemGroup>

  <!-- The fingerprint parses the sources with Roslyn (docs/adr/0023). The inline task compiles against netstandard, so it
       references the netstandard2.0 Roslyn of the package this project restores. At run time `dotnet build` binds it to the
       SDK's Roslyn, which must be no older than that package, and Visual Studio's MSBuild loads the package's own copy. -->
  <PropertyGroup>
    <_FingerprintRoslynVersion>$([System.IO.Path]::GetFileName($(PkgMicrosoft_CodeAnalysis_CSharp_Workspaces)))</_FingerprintRoslynVersion>
  </PropertyGroup>

  <UsingTask TaskName="ComputeGeneratorFingerprint" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <Task>
      <Reference Include="$(NuGetPackageRoot)microsoft.codeanalysis.common/$(_FingerprintRoslynVersion)/lib/netstandard2.0/Microsoft.CodeAnalysis.dll" />
      <Reference Include="$(NuGetPackageRoot)microsoft.codeanalysis.csharp/$(_FingerprintRoslynVersion)/lib/netstandard2.0/Microsoft.CodeAnalysis.CSharp.dll" />
      <Code Type="Class" Source="$(MSBuildThisFileDirectory)../../build/GeneratorFingerprint.cs" />
    </Task>
  </UsingTask>

  <Target Name="GenerateGeneratorVersion" BeforeTargets="CoreCompile">
    <ComputeGeneratorFingerprint PluginsRoot="$(MSBuildThisFileDirectory)../../../">
      <Output TaskParameter="Fingerprint" PropertyName="_GeneratorFingerprint" />
    </ComputeGeneratorFingerprint>
    <WriteLinesToFile File="$(IntermediateOutputPath)GeneratorVersion.g.cs"
                      Lines="namespace ConcurrencyHunter.Providers.LibraryModels { internal static class GeneratorVersion { internal const string Fingerprint = &quot;$(_GeneratorFingerprint)&quot;%3B } }"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)GeneratorVersion.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)GeneratorVersion.g.cs" />
    </ItemGroup>
  </Target>

  <!-- The engine fingerprint a framework census names (docs/adr/0022): the generator version without the built-in models. The census
       tool and `build/package.ps1 -Release` read it with
       `dotnet msbuild <this project> -restore -t:ComputeEngineFingerprint -getProperty:EngineFingerprint`. -->
  <Target Name="ComputeEngineFingerprint">
    <ComputeGeneratorFingerprint PluginsRoot="$(MSBuildThisFileDirectory)../../../" LeaveOutBuiltIn="true">
      <Output TaskParameter="Fingerprint" PropertyName="EngineFingerprint" />
    </ComputeGeneratorFingerprint>
  </Target>

</Project>
