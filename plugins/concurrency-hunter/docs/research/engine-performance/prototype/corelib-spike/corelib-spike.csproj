<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>CoreLibSpike</RootNamespace>
    <!-- restore only from the global packages folder: nothing is downloaded -->
    <RestoreSources>$(USERPROFILE)\.nuget\packages</RestoreSources>
    <!-- the decompiled CoreLib is written under out/ and is input data, not part of this tool -->
    <DefaultItemExcludes>$(DefaultItemExcludes);out/**;engine/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <Reference Include="ICSharpCode.Decompiler">
      <HintPath>C:\Program Files\Microsoft Visual Studio\18\Community\Common7\IDE\CommonExtensions\Microsoft\VBCSharp\LanguageServices\Core\ICSharpCode.Decompiler.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
