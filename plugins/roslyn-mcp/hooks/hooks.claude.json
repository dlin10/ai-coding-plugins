{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Grep|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/hooks/roslyn-grep-nudge.ps1\" -HostKind claude"
          }
        ]
      }
    ]
  }
}
