event: message
data: {"result":{"tools":[{"name":"roslyn_validate_file","description":"Validates a C# file and returns compiler errors, warnings, and optional analyzer diagnostics. success means no compiler errors; requestSucceeded means the request executed.","inputSchema":{"type":"object","properties":{"filePath":{"description":"Absolute path to the C# file to validate","type":"string"},"includeWarnings":{"description":"Include warnings in output (default: true)","type":"boolean","default":true},"runAnalyzers":{"description":"Run code analyzers in addition to compiler diagnostics (default: false)","type":"boolean","default":false}},"required":["filePath"]}},{"name":"roslyn_search_symbols","description":"Searches source symbol declarations across the entire solution using substring and camel-hump matching (for example, OSvc finds OrderService). Values above 500 are clamped.","inputSchema":{"type":"object","properties":{"query":{"description":"Substring or camel-hump pattern for source declarations (for example, OSvc finds OrderService)","type":"string"},"maxResults":{"description":"Maximum number of results to return (default: 30, maximum: 500)","type":"integer","default":30}},"required":["query"]}},{"name":"roslyn_get_document_symbols","description":"Lists all symbols in a C# file as a tree (namespaces, types, members) with accessibility, modifiers, line spans, and document-scoped compilation identity. projectName includes the target framework for multi-targeted projects.","inputSchema":{"type":"object","properties":{"filePath":{"description":"Absolute path to the C# file","type":"string"}},"required":["filePath"]}},{"name":"roslyn_find_dead_code","description":"Finds potentially dead code (types, methods, fields with no source references) in the active workspace. Values above 1000 are clamped.","inputSchema":{"type":"object","properties":{"maxResults":{"description":"Maximum number of dead code entries to return (default: 200, maximum: 1000)","type":"integer","default":200},"includeInternal":{"description":"Include internal and private members (default: true). When false, only private members are reported unless includePublic is also true.","type":"boolean","default":true},"includePublic":{"description":"Include public, protected, and protected internal members (default: false). This is broader and may include externally used APIs.","type":"boolean","default":false}}}},{"name":"roslyn_find_references","description":"Finds deduplicated references to a symbol, ordered by file and line. The referenced symbol appears once at the response level; each location includes its fully-qualified containingSymbol plus enclosingStartLine/enclosingEndLine, the declaration span of that containing member \u2014 read those lines directly to see the surrounding code instead of calling roslyn_get_document_symbols. Also returns document-scoped compilation identity; projectName includes the target framework for multi-targeted projects.","inputSchema":{"type":"object","properties":{"filePath":{"description":"Absolute path to the C# file","type":"string"},"line":{"description":"Line number (1-based)","type":"integer"},"column":{"description":"Column number (1-based)","type":"integer"},"maxResults":{"description":"Maximum number of results to return (default: 50, maximum: 500)","type":"integer","default":50}},"required":["filePath","line","column"]}},{"name":"roslyn_go_to_definition","description":"Navigates to the definition of a symbol at a given position. Returns source locations or metadata assembly names plus document-scoped compilation identity; projectName includes the target framework for multi-targeted projects.","inputSchema":{"type":"object","properties":{"filePath":{"description":"Absolute path to the C# file","type":"string"},"line":{"description":"Line number (1-based)","type":"integer"},"column":{"description":"Column number (1-based)","type":"integer"}},"required":["filePath","line","column"]}},{"name":"roslyn_get_symbol_info","description":"Gets detailed information for a symbol at a specific position, including a Roslyn display string, XML documentation, and document-scoped compilation identity. projectName includes the target framework for multi-targeted projects.","inputSchema":{"type":"object","properties":{"filePath":{"description":"Absolute path to the C# file","type":"string"},"line":{"description":"Line number (1-based)","type":"integer"},"column":{"description":"Column number (1-based)","type":"integer"}},"required":["filePath","line","column"]}},{"name":"roslyn_find_implementations","description":"Finds implementing classes and derived interfaces for an interface, derived classes for a class, implementations of interface members, or overrides of virtual and abstract members. Includes document-scoped compilation identity; projectName carries the target framework.","inputSchema":{"type":"object","properties":{"filePath":{"description":"Absolute path to the C# file containing the symbol","type":"string"},"line":{"description":"Line number (1-based)","type":"integer"},"column":{"description":"Column number (1-based)","type":"integer"},"maxResults":{"description":"Maximum number of results to return (default: 50, maximum: 500)","type":"integer","default":50}},"required":["filePath","line","column"]}},{"name":"roslyn_find_callers","description":"Finds call sites grouped by calling member. Direct calls are marked caller; calls through interface or override relationships are marked indirect-caller. Each call site carries enclosingStartLine/enclosingEndLine, the declaration span of the calling member \u2014 read those lines directly to see the call in context instead of calling roslyn_get_document_symbols. Includes document-scoped compilation identity; projectName carries the target framework.","inputSchema":{"type":"object","properties":{"filePath":{"description":"Absolute path to the C# file containing the method or property","type":"string"},"line":{"description":"Line number (1-based)","type":"integer"},"column":{"description":"Column number (1-based)","type":"integer"},"maxResults":{"description":"Maximum number of call sites to return (default: 50, maximum: 500)","type":"integer","default":50}},"required":["filePath","line","column"]}}]},"id":2,"jsonrpc":"2.0"}

