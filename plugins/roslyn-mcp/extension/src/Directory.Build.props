<Project>
  <!-- The one place the release version is written. The VSIX manifest, the package registration, the
       shim's serverInfo and the pipe names all take it from here; the three host manifests and the
       README title repeat it, and scripts/validate-plugins.mjs fails when they differ. -->
  <PropertyGroup>
    <Version>3.0.0-preview.2</Version>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>
  <!-- The extension and its tests both inherit the VS SDK's pinned dependency graph, whose
       advisories cannot be resolved from here. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'RoslynMcpExtension' And '$(MSBuildProjectName)' != 'RoslynMcpExtension.Tests'">
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>
</Project>
