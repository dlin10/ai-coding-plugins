<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>RoslynMcpExtension.Server</RootNamespace>
    <NoWarn>$(NoWarn);StreamJsonRpc0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="StreamJsonRpc" VersionOverride="[2.25.29]" />
    <!-- StreamJsonRpc 2.25.29 brings MessagePack 2.5.302 (GHSA-qhrr-8q5h-9q3h); drop once it brings 2.5.303 or later. -->
    <PackageReference Include="MessagePack" VersionOverride="2.5.303" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RoslynMcpExtension.Shared\RoslynMcpExtension.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The eleven analysis tools live with the headless shim; this server, which #214 retires, compiles them too.
         roslyn_load is the shim's own: here Visual Studio has the solution loaded. -->
    <Compile Include="..\RoslynMcpExtension.Cli\Tools\*.cs" Exclude="..\RoslynMcpExtension.Cli\Tools\LoadTool.cs"
             Link="Tools\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
