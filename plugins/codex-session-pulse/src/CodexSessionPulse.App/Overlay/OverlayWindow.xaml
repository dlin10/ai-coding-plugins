<Window x:Class="CodexSessionPulse.App.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ov="clr-namespace:CodexSessionPulse.App.Overlay"
        x:ClassModifier="internal"
        Title="Codex Session Pulse"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        Focusable="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI"
        FontSize="12pt"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />

    <Style x:Key="Separator" TargetType="TextBlock">
      <Setter Property="Text" Value=" · " />
      <Setter Property="Foreground" Value="{DynamicResource Pulse.Muted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ToneText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Pulse.Neutral}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding View.Tone}" Value="{x:Static ov:OverlayTone.Warm}">
          <Setter Property="Foreground" Value="{DynamicResource Pulse.Warm}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding View.Tone}" Value="{x:Static ov:OverlayTone.Expiring}">
          <Setter Property="Foreground" Value="{DynamicResource Pulse.Expiring}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding View.Tone}" Value="{x:Static ov:OverlayTone.Miss}">
          <Setter Property="Foreground" Value="{DynamicResource Pulse.Miss}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding View.Tone}" Value="{x:Static ov:OverlayTone.Error}">
          <Setter Property="Foreground" Value="{DynamicResource Pulse.Error}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="ToneFill" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Pulse.Neutral}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding View.Tone}" Value="{x:Static ov:OverlayTone.Warm}">
          <Setter Property="Background" Value="{DynamicResource Pulse.Warm}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding View.Tone}" Value="{x:Static ov:OverlayTone.Expiring}">
          <Setter Property="Background" Value="{DynamicResource Pulse.Expiring}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding View.Tone}" Value="{x:Static ov:OverlayTone.Miss}">
          <Setter Property="Background" Value="{DynamicResource Pulse.Miss}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding View.Tone}" Value="{x:Static ov:OverlayTone.Error}">
          <Setter Property="Background" Value="{DynamicResource Pulse.Error}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="LineText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Pulse.Foreground}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="FlatButton" TargetType="Button">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Foreground" Value="{DynamicResource Pulse.Foreground}" />
      <Setter Property="Background" Value="{DynamicResource Pulse.ButtonBackground}" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="Padding" Value="8,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Pulse.Track}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border MinWidth="500"
          MaxWidth="900"
          Height="40"
          Padding="12,0"
          CornerRadius="10"
          BorderThickness="1"
          Background="{DynamicResource Pulse.Background}"
          BorderBrush="{DynamicResource Pulse.Border}">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock Style="{StaticResource ToneText}" Text="{Binding View.StateText}" ToolTip="{Binding View.StateTooltip}" />

      <StackPanel Orientation="Horizontal" Visibility="{Binding View.ShowMetrics, Converter={StaticResource Visible}}">
        <Grid Width="96" Height="8" Margin="10,0,8,0" VerticalAlignment="Center" ToolTip="{Binding View.TtlTooltip}">
          <Border CornerRadius="4" Background="{DynamicResource Pulse.Track}" />
          <Border CornerRadius="4" Style="{StaticResource ToneFill}" RenderTransformOrigin="0,0.5"
                  Visibility="{Binding View.BarKnown, Converter={StaticResource Visible}}">
            <Border.RenderTransform>
              <ScaleTransform ScaleX="{Binding View.BarFraction}" />
            </Border.RenderTransform>
          </Border>
        </Grid>
        <TextBlock MinWidth="58" Text="{Binding View.TtlText}" ToolTip="{Binding View.TtlTooltip}">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource LineText}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding View.TtlText}" Value="">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <TextBlock Style="{StaticResource Separator}" />
        <TextBlock Style="{StaticResource LineText}" Text="{Binding View.TokensText}" ToolTip="{Binding View.TokensTooltip}" />
        <TextBlock Style="{StaticResource Separator}" />
        <TextBlock Style="{StaticResource LineText}" Text="{Binding View.SpeedText}" ToolTip="{Binding View.SpeedTooltip}" />
      </StackPanel>

      <TextBlock Style="{StaticResource Separator}" />
      <TextBlock Foreground="{DynamicResource Pulse.Muted}" VerticalAlignment="Center"
                 Text="{Binding View.SelectionText}" ToolTip="{Binding View.SelectionTooltip}" />
      <TextBlock Style="{StaticResource Separator}" />
      <TextBlock Foreground="{DynamicResource Pulse.Muted}" VerticalAlignment="Center"
                 Text="{Binding View.SourceText}" ToolTip="{Binding View.SourceTooltip}" />

      <Button Style="{StaticResource FlatButton}" Content="Choose folder" Click="OnChooseFolder"
              ToolTip="Choose the folder that holds the Codex rollout JSONL files"
              Visibility="{Binding View.ShowChooseFolder, Converter={StaticResource Visible}}" />
      <Button Style="{StaticResource FlatButton}" Content="Auto Warm" IsEnabled="False" ToolTip="{Binding AutoWarmHint}" />
    </StackPanel>
  </Border>
</Window>
